@startuml UC05_CreateAudioRecord
|User|
start
:选择要创建的音频文件;
if (文件已选择?) then (yes)
  :填写标题、描述;
  if (标题合法?) then (yes)
    :选择标签（可多选）;
    if (标签数量合法?) then (yes)
      |LLMService|
      :请求 LLM 生成摘要或建议;
      if (请求成功?) then (yes)
        |User|
        :显示 AI 建议;
      else (失败)
        |User|
        :提示“AI 建议暂时不可用”;
      endif
      |AudioRecord|
      :提交创建音频记录;
      if (保存成功?) then (yes)
        |Tag|
        :建立标签关系;
        |User|
        :显示“音频创建成功”;
      else (保存失败)
        |User|
        :显示“创建失败，请重试”;
      endif
    else (标签数量超限)
      |User|
      :显示“标签数量超限”;
    endif
  else (标题不合法)
    |User|
    :显示“标题不合法”;
  endif
else (未选择文件)
  |User|
  :禁止提交，提示选择文件;
endif

stop
@enduml
