@startuml UC13_LLMSuggestion
|Frontend|
start
:发起“AI 辅助”请求;

if (请求内容为空?) then (yes)
  :拒绝请求，提示“内容不能为空”;
  stop
endif
:发送请求到后端;

|LLM|
if (网络可用?) then (yes)
  :调用 LLM API 获取建议;
  if (API 返回超时?) then (yes)
    |Frontend|
    :提示“AI 服务繁忙”;
    stop
  endif
|LLM|
  if (API 返回错误?) then (yes)
    |Frontend|
    :提示“今日请求次数过多”;
    stop
  endif
  |Audio|
  :获取 LLM 建议声音记录;
  |Frontend|
  :显示 LLM 建议声音记录;
|LLM|
else (网络异常)
  |Frontend|
  :无法调用 LLM 服务，提示网络异常;
endif

stop
@enduml
