@startuml
title UC-01/UC-02/UC-03: 用户注册(含验证码)、登录与找回密码流程
autonumber
skinparam responseMessageBelowArrow true

actor "用户 (User)" as User
participant "前端 (Frontend)" as FE
participant "认证服务 (Auth Service)" as AuthService
database "缓存 (Redis/Cache)" as Cache
database "数据库 (MySQL)" as DB

== 用户注册 (Register) ==
User -> FE : 输入用户名、邮箱、密码
FE -> FE : 格式校验 (邮箱/手机号)
alt 格式错误
    FE --> User : 显示格式错误提示
else 格式正确
    FE -> AuthService : POST /api/register/send-code (Email)
    activate AuthService
    AuthService -> DB : 检查唯一性 (User/Email/Phone)
    alt 账号已存在
        AuthService --> FE : 返回错误 "账号已存在"
    else 校验通过
        AuthService -> AuthService : 生成 6 位验证码
        AuthService -> Cache : 存储验证码 (Email, Code, TTL=5min)
        AuthService -> AuthService : 发送激活邮件
        AuthService --> FE : 返回 "验证码已发送"
        deactivate AuthService
        
        FE --> User : 弹出验证码输入框
        User -> FE : 输入验证码并确认
        
        FE -> AuthService : POST /api/register/verify
        activate AuthService
        AuthService -> Cache : 查询验证码
        alt 验证码错误或过期
            AuthService --> FE : 返回 "验证码无效"
        else 验证码正确
            AuthService -> AuthService : 密码 Bcrypt 加密
            AuthService -> DB : 创建 AuthenticationAccount
            alt 创建账号失败 (DB Error)
                 DB --> AuthService : Error
                 AuthService --> FE : 返回 "系统错误"
            else 创建账号成功
                 AuthService -> DB : 创建默认 UserProfile
                 alt 创建资料失败
                     DB --> AuthService : Error
                     AuthService -> DB : 回滚账号创建
                     AuthService --> FE : 返回 "系统错误"
                 else 创建资料成功
                     DB --> AuthService : Success
                     AuthService -> Cache : 删除已使用的验证码
                     AuthService --> FE : 注册成功
                 end
            end
        end
    end
    deactivate AuthService
    FE --> User : 显示注册成功，跳转登录
end

== 找回密码 (Forgot Password) ==
User -> FE : 点击“忘记密码”
FE --> User : 跳转至密码重置页面

User -> FE : 输入邮箱/手机号
FE -> FE : 格式校验
FE -> AuthService : POST /api/forgot-password
activate AuthService

AuthService -> DB : 查询账号是否存在
alt 账号不存在
    DB --> AuthService : 未找到
    AuthService --> FE : 返回“该邮箱/手机号未注册”
else 账号存在
    AuthService -> AuthService : 生成一次性验证码（或重置令牌）
    AuthService -> Cache : 保存重置令牌 (TTL=5min)
    AuthService -> AuthService : 发送邮件/SMS

    AuthService --> FE : 返回“验证码已发送”
    FE --> User : 显示验证码输入框 / 等待用户点击链接

    User -> FE : 输入验证码 + 新密码
    FE -> AuthService : POST /api/reset-password
    AuthService -> Cache : 查询有效重置令牌
    alt 令牌无效或过期
        AuthService --> FE : 返回“验证码无效或已过期”
    else 令牌有效
        AuthService -> AuthService : 验证新密码强度
        AuthService -> AuthService : Bcrypt 加密新密码
        AuthService -> DB : 更新 AuthenticationAccount 密码
        DB --> AuthService : 更新成功
        AuthService --> FE : 返回“密码重置成功”
        FE --> User : 提示“请重新登录”
    end
end
deactivate AuthService

== 用户登录 (Login) ==
User -> FE : 输入账号 + 密码
FE -> AuthService : POST /api/login
activate AuthService

AuthService -> DB : 查询账号信息
alt 账号不存在
    DB --> AuthService : Null
    AuthService --> FE : 返回 "账号不存在"
else 账号存在
    DB --> AuthService : 返回 Hash 密码
    AuthService -> AuthService : 校验密码 (Bcrypt Match)

    alt 密码错误
        AuthService --> FE : 返回 "账号或密码错误"
    else 验证成功
        AuthService -> DB : 检查账号状态 (是否封禁)
        alt 账号被封禁
            DB --> AuthService : Status = Banned
            AuthService --> FE : 返回 "账号被封禁"
        else 状态正常
            AuthService -> AuthService : 生成 JWT Token
            alt Token 生成失败
                AuthService --> FE : 返回 "登录失败，请重试"
            else Token 生成成功
                AuthService --> FE : 返回 Token
                FE -> FE : 存储 Token (LocalStorage/Cookie)
                FE --> User : 跳转至首页
            end
        end
    end
end
deactivate AuthService

@enduml