@startuml
title UC-08/UC-09/UC-14: 互动操作流程
autonumber
skinparam sequenceMessageAlign center

actor "用户" as User
participant "前端" as FE
participant "社交服务 (Social Svc)" as Social
database "数据库" as DB
participant "Redis 缓存" as Cache

== 场景 A: 点赞 (Like) ==
User -> FE : 点击点赞按钮
FE -> Social : POST /like (TargetId, Type)
activate Social

Social -> DB : 查询目标是否存在 (Record/Comment)
alt 目标不存在
    DB --> Social : Null
    Social --> FE : 404 Not Found
    FE --> User : 提示"内容已删除"
else 目标存在
    Social -> DB : 查询是否已点赞
    alt 未点赞
        Social -> DB : Insert Like 记录
        alt 插入失败
            DB --> Social : Error
            Social --> FE : 500 Error
        else 插入成功
            Social -> DB : Update Record 点赞数 (+1)
            Social -> Cache : 更新热门权重 (Score++)
            Social --> FE : 返回 "点赞成功"
        end
    else 已点赞
        Social -> DB : Delete Like 记录
        Social -> DB : Update Record 点赞数 (-1)
        Social -> Cache : 更新热门权重 (Score--)
        Social --> FE : 返回 "取消点赞"
    end
end
deactivate Social
FE -> User : 更新图标状态

== 场景 B: 收藏 (Favorite) ==
User -> FE : 点击收藏按钮
FE -> Social : POST /favorite
activate Social
Social -> DB : 查询音频记录是否存在
alt 记录不存在
    DB --> Social : Null
    Social --> FE : 404 Not Found
else 记录存在
    Social -> DB : 切换收藏状态 (Toggle)
    alt DB操作失败
        DB --> Social : Error
        Social --> FE : 500 Error
    else 操作成功
        DB --> Social : 更新结果
        Social --> FE : 返回最新状态
    end
end
deactivate Social

== 场景 C: 评论 (Comment) ==
User -> FE : 输入评论并发送
FE -> Social : POST /comment
activate Social
Social -> DB : 查询音频记录是否存在
alt 记录不存在
    DB --> Social : Null
    Social --> FE : 404 Not Found
else 记录存在
    Social -> DB : 插入 Comment 记录
    alt 插入失败
        DB --> Social : Error
        Social --> FE : 500 Error
    else 插入成功
        DB --> Social : Success
        Social --> FE : 返回评论数据
        deactivate Social
        FE -> FE : 列表追加新评论
    end
end

@enduml
