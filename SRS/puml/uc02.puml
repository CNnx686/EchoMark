@startuml UC02_UserLogin_Entities
|Frontend|
start
:用户输入用户名/邮箱/手机号和密码;
|Auth|
:验证账号是否存在;
if (账号存在?) then (yes)
  :比对密码哈希;
  if (密码正确?) then (yes)
    |Common(Session / Token)|
    :生成 JWT Token;
    if (生成成功?) then (yes)
      |Auth|
      :检查账号是否被封禁;
      if (账号封禁?) then (yes)
        |Auth|
        :允许登录，加载首页数据;
      else (no)
        |Frontend|
        :阻止登录，提示账号被封禁;
      endif
    else (生成失败)
      |Frontend|
      :返回“无法登录，请稍后重试”;
    endif
  else (密码错误)
    |Auth|
    :记录密码错误次数;
    if (次数过多?) then (yes)
      :锁定账号 X 分钟;
    endif
    |Frontend|
    :返回“密码不正确”;
  endif
else (账号不存在)
  |Frontend|
  :返回“账号不存在”;
endif

stop
@enduml
