@startuml UC03_EditProfile_AdminOnly
|Admin|
start
:打开“个人资料”页面;
:编辑头像、昵称、简介等信息;
:提交修改;

|UserProfile|
:检查管理员账号是否被封禁;
if (账号未封禁?) then (yes)
  :校验头像格式与大小;
  if (头像合法?) then (yes)
    :校验昵称合法性;
    if (昵称合法?) then (yes)
      :校验简介长度;
      if (简介合法?) then (yes)
        :直接更新主资料（立即生效）;
        if (保存成功?) then (yes)
          |Admin|
          :显示“修改成功”提示;
        else (保存失败)
          |Admin|
          :显示“保存失败，请重试”;
        endif
      else (简介超长)
        |Admin|
        :显示“简介超长”提示;
      endif
    else (昵称不合法)
      |Admin|
      :显示“昵称不合法”提示;
    endif
  else (头像不合法)
    |Admin|
    :显示“头像上传失败”;
  endif
else (封禁)
  |Admin|
  :显示“账号被锁定，无法修改资料”;
endif

|Admin|
stop
@enduml