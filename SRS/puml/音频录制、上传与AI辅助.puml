@startuml
title UC-04/UC-13: 音频录制、上传与AI辅助
autonumber

actor "User" as User
participant "Frontend" as FE
participant "Audio" as AudioSvc
participant "对象存储 (OSS/MinIO)" as OSS
participant "LLM 服务 (AI)" as LLM
database "数据库" as DB

== 阶段 1: 录制与上传 ==
User -> FE : 点击"录音"
FE -> User : 请求麦克风 & GPS 权限
alt 用户拒绝权限
    User --> FE : 拒绝
    FE --> User : 提示"无法录音/定位，请授权"
else 授权通过
    User --> FE : 授权
    FE -> FE : 录制音频 (Audio Capture)
    User -> FE : 停止录音
    == 阶段 2: AI 辅助 (可选) ==
            opt 用户点击 "AI 辅助建议" (UC-13)
                FE -> AudioSvc : 请求 AI 分析 (Text/Audio)
                activate AudioSvc
                AudioSvc -> LLM : 调用大模型 API (Prompt)
                activate LLM
                alt LLM 服务不可用/超时
                    LLM --> AudioSvc : Error / Timeout
                    AudioSvc --> FE : 返回 "AI 服务繁忙"
                    FE --> User : 提示 "AI 建议暂时不可用"
                else LLM 返回结果
                    LLM --> AudioSvc : 返回摘要、情绪、建议标题
                    deactivate LLM
                    AudioSvc --> FE : 返回建议内容 (不存储)
                    deactivate AudioSvc
                    FE -> User : 填充建议供用户修改
                end
            end
            == 阶段 3: 创建记录 ==
            User -> FE : 填写标题、描述、标签
            FE -> AudioSvc : POST /api/records (含 AudioUrl, Location)
            activate AudioSvc
            AudioSvc -> DB : 保存 AudioRecord
            alt 保存失败
                DB --> AudioSvc : Error
                AudioSvc --> FE : 返回 "创建失败"
            else 保存成功
                AudioSvc -> DB : 保存 RecordTag 关联
                DB --> AudioSvc : 保存成功
                AudioSvc --> FE : 返回 RecordId
                FE --> User : 显示"发布成功"
            end
            deactivate AudioSvc
        end
    

@enduml
